---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import PageSection from "../../components/ui/PageSection.astro";
import CardGrid from "../../components/ui/CardGrid.astro";
import Card from "../../components/ui/Card.astro";
import CTAStrip from "../../components/ui/CTAStrip.astro";

// The Sparcle release signing key. Published HERE, on sparcle.app, deliberately: the
// signature and the checksums live on the GitHub release, so anyone forging a download would
// have to compromise both the release and this site. A public key beside the file it signs
// proves nothing.
const RELEASE_PUBKEY = "RWR074VTKBGzGWsQbnByhGrH9pQG5uHOJSgqL8rs5Zu4GQAxZ1C+JIza";

const steps = [
  {
    title: "1. Download the checksums and the signature",
    body: "Both live on the release you downloaded from. SHA256SUMS lists a SHA-256 for every installer and CLI binary in that release; SHA256SUMS.minisig is our signature over that file.",
    code: "curl -LO https://sparcle.app/releases/latest/SHA256SUMS\ncurl -LO https://sparcle.app/releases/latest/SHA256SUMS.minisig",
  },
  {
    title: "2. Check the signature against our key",
    body: "This is the step that proves origin. If it fails, stop. The checksums themselves cannot be trusted, so verifying against them would be meaningless.",
    code: `minisign -Vm SHA256SUMS -P '${RELEASE_PUBKEY}'`,
  },
  {
    title: "3. Check your download against the checksums",
    body: "Only once the signature verifies. On macOS and Linux, shasum reads the manifest and reports OK for the file you have.",
    code: "shasum -a 256 --ignore-missing -c SHA256SUMS",
  },
];
---

<BaseLayout
  title="Verify your download | Sparcle"
  description="How to confirm a Bolt download came from Sparcle and has not been tampered with: the release signing public key, and the exact commands to verify checksums and signature."
>
  <Hero
    eyebrow="Trust"
    title="Verify your download."
    lede="Anyone can publish a file. These are the commands that prove the one you downloaded is the one we built."
  />

  <PageSection
    title="Why a checksum alone is not enough"
    lede="A SHA-256 proves a file arrived intact. It does not prove who made it: whoever could replace an installer could replace the checksum list in the same action, and both would still match. So we sign the checksum list itself, and publish the key here rather than next to it."
  >
    <CardGrid>
      <Card title="What the signature covers">
        One signature over SHA256SUMS covers every artifact in the release, because that file
        lists them all: installers, the CLI binaries, every platform.
      </Card>
      <Card title="Why the key is on this page">
        The signature and checksums are on GitHub. The key is here. Forging a download means
        compromising both, not one.
      </Card>
      <Card title="If verification fails">
        Do not install it. Tell us at bolt@sparcle.app and we will confirm what the current
        release should be.
      </Card>
    </CardGrid>
  </PageSection>

  <PageSection title="The Sparcle release signing key">
    <p>
      Ed25519, via <a href="https://jedisct1.github.io/minisign/">minisign</a>
      (<code>brew install minisign</code>, <code>apt install minisign</code>). This key signs
      the checksum manifest of every Bolt release.
    </p>
    <div class="vd-code-block"><code>{RELEASE_PUBKEY}</code></div>
    <p>
      If this key ever changes we will say so here and explain why. A key that changes without
      explanation is a reason to stop and ask us.
    </p>
  </PageSection>

  <PageSection
    title="Verifying, step by step"
    lede="These three commands work on the current release right now. Older releases carry SHA256SUMS without a signature, so step 3 works on them and step 2 does not; every release from v0.1.140 onward is signed."
  >
    {steps.map((s) => (
      <div class="verify-step">
        <h3>{s.title}</h3>
        <p>{s.body}</p>
        <div class="vd-code-block"><code>{s.code}</code></div>
      </div>
    ))}
  </PageSection>

  <PageSection
    title="Platform trust, and where it stands"
    lede="Two platform-level certifications are in progress. Neither affects the verification above, which works today and depends on no one else."
  >
    <CardGrid>
      <Card title="macOS Gatekeeper">
        <strong>Apple notarization: in progress.</strong> Developer enrollment is underway.
        Until it completes, macOS cannot vouch for Bolt natively, so our installer clears the
        quarantine attribute during install. We would rather name that than have you find it in
        the script: it is the one step in the install we would want explained to us. When
        enrollment lands, builds are signed with an Apple-issued Developer ID and notarized, and
        the step goes away with no action from you.
      </Card>
      <Card title="Windows SmartScreen">
        <strong>Authenticode certificate: in procurement.</strong> Until it is issued,
        SmartScreen may warn on first run. The signature above already verifies Windows
        downloads today, independently of SmartScreen, and the current Windows installer is
        clean across every engine on VirusTotal.
      </Card>
      <Card title="In-app updates">
        Updates delivered inside Bolt are separately signed and verified by the app against a
        key built into it, so an update cannot be swapped even if a release were altered. That
        is automatic and needs nothing from you.
      </Card>
    </CardGrid>
  </PageSection>

  <CTAStrip
    variant="band"
    title="Something not verifying?"
    lede="If a signature or checksum does not match, do not install it. Tell us and we will confirm what the current release should be."
  >
    <a href="mailto:bolt@sparcle.app" class="btn btn-primary btn-lg">Email bolt@sparcle.app</a>
    <a href="/trust/" class="btn btn-secondary btn-lg">Back to Trust Center</a>
  </CTAStrip>
</BaseLayout>

<style>
  /* Same terminal treatment as the download page's install command, deliberately: a reader
     who has just copied `curl | sh` from there should recognise these as the same kind of
     thing. Unstyled <pre> rendered as plain prose and the commands disappeared into the text. */
  .vd-code-block {
    background: #0f1424;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    margin: 0.75rem 0 0;
    overflow-x: auto;
  }
  .vd-code-block code {
    display: block;
    font-size: 0.82rem;
    color: #a6e3a1;
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: normal;
    user-select: all;   /* one click selects the whole command, or the whole key */
    line-height: 1.6;
  }
  .verify-step { margin-bottom: 2.25rem; }
  .verify-step h3 { margin-bottom: 0.35rem; }
  .verify-step p { margin-bottom: 0; }
</style>
